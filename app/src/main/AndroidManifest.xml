<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Deliberately no permissions yet. Tracking permissions (PACKAGE_USAGE_STATS,
        POST_NOTIFICATIONS, package <queries>) arrive in Phase 3, and INTERNET is
        intentionally absent so the local-first claim stays verifiable.
    -->

    <application
        android:name=".UndertowApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Undertow">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Undertow">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
